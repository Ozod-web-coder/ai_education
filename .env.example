SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Пока не задано — используется SQLite (db.sqlite3).
# Для PostgreSQL:
# DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/ai_education

# ИИ-консультант: любой OpenAI-совместимый API. Пока не задано — бот работает
# без ИИ (кнопки теста и подбора группы), письмо проверяет методист.
# Ollama (локально, бесплатно):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b
# Google Gemini (бесплатный тариф, ключ на aistudio.google.com/apikey).
# Имена моделей меняются — актуальный список: python manage.py check_llm сообщит об ошибке 404.
# У gemini-3.5-flash бесплатно всего 20 запросов в сутки, поэтому диалог — на lite-моделях,
# а точная модель — только для оценки письма (1 запрос на ученика).
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_MODELS=gemini-3.1-flash-lite
# LLM_WRITING_MODEL=gemini-3.5-flash
# LLM_API_KEY=...
# Groq (бесплатный тариф, ключ на console.groq.com):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=...

TELEGRAM_INIT_DATA_MAX_AGE=86400
BOOKING_HOLD_MINUTES=15
