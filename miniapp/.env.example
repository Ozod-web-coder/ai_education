# Адрес API. В разработке оставьте пустым: Vite проксирует /api на http://127.0.0.1:8000.
# В проде укажите полный адрес бэкенда, например https://api.example.com/api
VITE_API_URL=

# Код учебного центра (Center.slug в админке Django).
VITE_CENTER_SLUG=demo

# Только для разработки в обычном браузере, без Telegram: access-токен сотрудника.
# Получить: python manage.py shell -c "from rest_framework_simplejwt.tokens import AccessToken; from apps.core.models import User; print(AccessToken.for_user(User.objects.get(username='ВАШ_ЛОГИН')))"
# VITE_DEV_TOKEN=
